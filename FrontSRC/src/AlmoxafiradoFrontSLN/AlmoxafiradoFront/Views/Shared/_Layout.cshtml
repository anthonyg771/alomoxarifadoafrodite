<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/categoria.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlmoxafiradoFront.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="cabecalho">
        <div class="menu">
            <div class="itemmenu">
                <a href="https://localhost:44361/Produto">
                    <span class="itemtexto">Produto</span>
                </a>
            </div>
            <div class="itemmenu">
                <a href="https://localhost:44361/Entrada">
                    <span class="itemtexto">Entrada</span>
                </a>
            </div>
            <div class="itemmenu">
                <a href="https://localhost:44361/Saida">
                    <span class="itemtexto">Saída</span>
                </a>
            </div>
            <div class="itemmenu">
                <a href="https://localhost:44361/Categoria">
                    <span>Categoria</span>
                </a>
            </div>
            <div class="itemmenu">
                <a href="https://localhost:44361/Gestao">
                    <span class="itemtexto">Gestão</span>
                </a>
            </div>
        </div>
        <div class="perfil">
            <span class="pessoa">Reginaldo</span>
            <span class="loginlogoff">Logoff</span>
        </div>
    </div>
    <div class="pagina">
        <div class="conteudo">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
</html>